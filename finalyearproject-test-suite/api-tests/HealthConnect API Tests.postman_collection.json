    {
      "name": "IT-15 | Forged Stripe webhook signature is rejected",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Forged signature rejected with 400', () => pm.response.to.have.status(400));",
              "pm.test('No success payload returned', () => pm.expect(pm.response.text()).to.not.include('\"received\":true'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Stripe-Signature",
            "value": "t=1700000000,v1=forged_signature_for_testing",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"evt_forged_test\",\n  \"type\": \"checkout.session.completed\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"cs_test_forged\",\n      \"metadata\": {\n        \"appointmentId\": \"00000000-0000-0000-0000-000000000000\"\n      }\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": ""
        },
        "description": "Uses a dummy appointmentId so no real record can change"
      },
      "response": []
    },
