      "name": "IT-17 | TURN credentials function rejects a request with no auth",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unauthenticated request rejected (400 or 401)', () => pm.expect([400, 401]).to.include(pm.response.code));",
              "pm.test('No ICE server config leaked', () => pm.expect(pm.response.text()).to.not.include('urls'));",
              "console.log('IT-17 actual status:', pm.response.code, '(report recorded 400)');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
