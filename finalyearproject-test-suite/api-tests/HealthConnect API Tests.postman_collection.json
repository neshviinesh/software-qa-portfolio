  "item": [
    {
      "name": "IT-05 | RLS blocks cross-user read (appointments)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request accepted (status 200)', () => pm.response.to.have.status(200));",
              "pm.test('RLS returns zero rows for another user', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.be.an('array').that.is.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "apikey",
            "value": "{{SUPABASE_ANON_KEY}}",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{SUPABASE_ANON_KEY}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": ""
        },
        "description": "Sends the anon key only, asking for another user's appointments. Expected: empty array."
      },
      "response": []
    },
    {
      "name": "IT-10 | Symptom checker returns structured triage (standard input)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('Has urgency in low/moderate/high', () => pm.expect(['low','moderate','high']).to.include(j.urgency));",
              "pm.test('possible_conditions is an array', () => pm.expect(j.possible_conditions).to.be.an('array'));",
              "pm.test('Not flagged as emergency', () => pm.expect(j.emergency).to.not.equal(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{SUPABASE_ANON_KEY}}",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{SUPABASE_ANON_KEY}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"symptoms\": \"headache, nausea\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": ""
        },
        "description": "Calls the Groq-backed edge function"
      },
      "response": []
