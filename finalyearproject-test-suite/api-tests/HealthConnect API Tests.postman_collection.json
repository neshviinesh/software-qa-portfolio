    {
      "name": "IT-12 | Condition explainer returns a short explanation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('Echoes the condition', () => pm.expect(j.condition).to.be.a('string').and.not.empty);",
              "pm.test('meaning is a non-empty string', () => pm.expect(j.meaning).to.be.a('string').and.not.empty);",
              "pm.test('meaning is at most 3 sentences', () => {",
              "  const n = (j.meaning.match(/[.!?](\\s|$)/g) || []).length;",
              "  pm.expect(n).to.be.within(1, 3);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{SUPABASE_ANON_KEY}}",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{SUPABASE_ANON_KEY}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"condition\": \"viral gastroenteritis\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": ""
        },
        "description": "Checks the 3-sentence limit from the system prompt."
      },
      "response": []
